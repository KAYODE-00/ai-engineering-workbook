### app/main.py  (Pattern 1: RAG)

Parts marked REUSE you copy unchanged. Parts marked EDIT you change per project.

```python
import os
import shutil

from dotenv import load_dotenv
from fastapi import FastAPI, File, UploadFile
from fastapi.responses import FileResponse
from fastapi.staticfiles import StaticFiles
from pydantic import BaseModel
from pypdf import PdfReader
import chromadb
from chromadb.utils import embedding_functions
from groq import Groq

load_dotenv()
os.makedirs("data", exist_ok=True)

app = FastAPI()

# ---------- REUSE: settings, embedding, storage ----------
MODEL = "openai/gpt-oss-120b"   # check the provider's current model list

embedding_fn = embedding_functions.SentenceTransformerEmbeddingFunction(
    model_name="all-MiniLM-L6-v2"
)
client = chromadb.PersistentClient(path="chroma_db")
collection = client.get_or_create_collection(
    name="docs", embedding_function=embedding_fn
)
groq_client = Groq(api_key=os.environ.get("GROQ_API_KEY"))


# ---------- REUSE: data shape ----------
class Question(BaseModel):
    text: str


# ---------- EDIT: how to get text and how to chunk ----------
def read_pdf(path: str) -> str:
    reader = PdfReader(path)
    text = ""
    for page in reader.pages:
        extracted = page.extract_text()
        if extracted:
            text += extracted + "\n"
    return text


def chunk_text(text: str) -> list[str]:
    # EDIT THIS RULE for every new kind of document
    parts = text.split("\n\n")
    return [p.strip() for p in parts if len(p.strip()) > 50]


# ---------- REUSE: upload = chunk + embed + store ----------
@app.post("/upload")
async def upload(file: UploadFile = File(...)):
    path = f"data/{file.filename}"
    with open(path, "wb") as buffer:
        shutil.copyfileobj(file.file, buffer)

    text = read_pdf(path)
    chunks = chunk_text(text)
    if not chunks:
        return {"filename": file.filename, "chunks_added": 0}

    collection.upsert(
        documents=chunks,
        ids=[f"{file.filename}_chunk_{i}" for i in range(len(chunks))],
        metadatas=[{"source": file.filename} for _ in chunks],
    )
    return {"filename": file.filename, "chunks_added": len(chunks)}


# ---------- REUSE: ask = retrieve + generate ----------
@app.post("/ask")
def ask(q: Question):
    results = collection.query(query_texts=[q.text], n_results=3)
    chunks = results["documents"][0]
    if not chunks:
        return {"question": q.text, "answer": "No documents uploaded yet."}

    context = "\n\n".join(chunks)

    # EDIT: wording of the prompt for your project
    prompt = f"""Answer the question using ONLY the context below.
If the answer is not in the context, say "I don't know."

Context:
{context}

Question: {q.text}
"""
    resp = groq_client.chat.completions.create(
        model=MODEL,
        messages=[{"role": "user", "content": prompt}],
    )
    return {
        "question": q.text,
        "answer": resp.choices[0].message.content,
        "sources": results["metadatas"][0],
        "distances": results["distances"][0],
    }


# ---------- REUSE: serve the UI ----------
if os.path.isdir("static"):
    app.mount("/static", StaticFiles(directory="static"), name="static")

    @app.get("/")
    def home():
        return FileResponse("static/index.html")
```

Run it: `uvicorn app.main:app --reload`, then open `/docs`.

### Build order for a new project (write the FAKE version first)

1. Make folders, venv, `.gitignore`, `.env`. Install requirements.
2. Write only the server and a fake `/ask` that returns `{"answer": "test"}`. Run it. Prove the wiring works.
3. Write `chunk_text` for your documents. Print the chunks. Look at them.
4. Add `/upload` (chunk, embed, store). Upload one file. Check the count.
5. Replace the fake `/ask` with real retrieval. Print the chunks it returns. Are they the right ones?
6. Add generation.
7. Write test questions (`evaluate.py`).
8. UI, then Docker, then deploy.
9. Commit after every step.

If something breaks, you always know which step it is in.

### Pattern 2: Extraction (no retrieval, no Chroma)

Use when you want fields out of one document.

```python
import json

@app.post("/extract")
def extract(doc: Document):          # Document has a `text: str` field
    prompt = f"""Extract these fields and return ONLY valid JSON:
- invoice_number
- date
- bill_to
- amount
- due_date
If a field is missing, use null.

Document:
{doc.text}
"""
    resp = groq_client.chat.completions.create(
        model=MODEL, messages=[{"role": "user", "content": prompt}]
    )
    raw = resp.choices[0].message.content
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return {"error": "Model did not return valid JSON", "raw": raw}
```

What you EDIT: the field list. How you test it: documents with known correct fields, including messy ones and ones with missing fields.

### Pattern 3: Agent with a tool (optional layer on top of RAG)

Only add this after the plain RAG version works.

```python
from langchain_core.tools import tool
from langchain_groq import ChatGroq

@tool
def search_docs(query: str) -> str:
    """Search the uploaded documents. Use for questions about their content."""
    r = collection.query(query_texts=[query], n_results=3)
    return "\n\n".join(r["documents"][0])

llm = ChatGroq(model=MODEL)
llm_with_tools = llm.bind_tools([search_docs])

# inside your /ask endpoint:
response = llm_with_tools.invoke(q.text)
if response.tool_calls:
    call = response.tool_calls[0]
    context = search_docs.invoke(call["args"])
    # ...then build the grounded prompt and generate, as in Part 3
else:
    answer = response.content   # the model answered without searching
```

The tool's docstring is a prompt. The model reads it to decide when to use the tool. Write it clearly.

### app/evaluate.py

```python
import requests

test_cases = [
    {"question": "EDIT: question 1", "expected": "EDIT: text the answer must contain"},
    {"question": "EDIT: question 2", "expected": "EDIT"},
]

results = []
for case in test_cases:
    r = requests.post("http://127.0.0.1:8000/ask", json={"text": case["question"]})
    answer = r.json()["answer"]
    passed = case["expected"].lower() in answer.lower()
    results.append(passed)
    print(f"Q: {case['question']}\nA: {answer}\nPASSED: {passed}\n---")

print(f"Passed {results.count(True)} of {len(test_cases)}")
```

Also add one question whose answer is NOT in your documents. The correct answer is "I don't know."

Run with the server running in another terminal: `python -m app.evaluate`

### Dockerfile

```dockerfile
FROM python:3.11-slim
WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
```

Why the extra `torch` line: `sentence-transformers` needs PyTorch. On Linux, pip may download the huge GPU version by default. The CPU version is much smaller and faster to install.

Heads-up for free hosting: free plans often have small memory (for example 512 MB). Loading an embedding model plus PyTorch may not fit. Check your host's limits before deploying. If it does not fit, use a hosted embedding API instead of a local model.

